<div class="max-w-md mx-auto mt-10">
<h1 class="text-2xl font-bold mb-4">ログイン</h1>

<%= form_with url: login_path,data:{turbo:false} do |form| %>
<div class="mb-4">
    <% if flash[:alert] %>
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
        <p><%= flash[:alert] %></p>
      </div>
    <% end %>
</div>
  <div class="flex flex-col mb-4">
    <%= form.label :email,"メールアドレス" ,class: "block text-sm font-medium text-gray-700"%>
    <%= form.email_field :email, required: true ,class: "shadow appearance-none border rounded py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline"%>
  </div>

  <div class="flex flex-col mb-4">
    <%= form.label :password,"パスワード" ,class: "block text-sm font-medium text-gray-700"%>
    <%= form.password_field :password, required: true ,class: "shadow appearance-none border rounded py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline"%>
  </div>

  <div>
    <%= form.submit "ログイン" ,class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-md" %>
  </div>
<% end %>
</div>