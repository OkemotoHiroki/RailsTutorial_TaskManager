<h1>タスク一覧</h1>

<%= link_to "タスクを追加", new_task_path, class: "btn btn-primary" %>

<table>
    <thead>
        <tr>
            <th>タイトル</th>
            <th>開始日</th>
            <th>終了日</th>
        </tr>
    </thead>
    <tbody>
        <% @tasks.each do |task| %>
        <tr>
            <td><%= link_to task.name, task_path(task) %></td>
            <td><%= task.start_datetime.strftime("%Y-%m-%d %H:%M") %></td>
            <td><%= task.end_datetime.strftime("%Y-%m-%d %H:%M") %></td>
        </tr>
        <% end %>
    </tbody>  
</table>