<div class="p-4">
<%= form_with(model: @task) do |form| %>
    <% if @task.errors.any? %>
        <div id="error_explanation" class="bg-red-100 border border-red-400 text-red-700 p-4 rounded mb-4">
        <h2 class="font-bold">入力に問題があります：</h2>
        <ul class="list-disc list-inside">
            <% @task.errors.full_messages.each do |message| %>
            <li><%= message %></li>
            <% end %>
        </ul>
        </div>
    <% end %>

    <div class="field flex flex-col mb-4">
        <%= form.label :name, "タイトル：", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :name, id: :task_name, class: "mt-1 block border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div class="field flex flex-col mb-4">
        <%= form.label :detail, "内容：", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_area :detail, id: :task_detail, class: "mt-1 block  border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div class="field">
        <%= form.label :start_datetime, "開始日時：",class: "block" %>
        <%= form.datetime_select :start_datetime, id: :task_start_datetime, class: "mt-1 block  border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
    </div>
    <div class="field">
        <%= form.label :end_datetime, "終了日時：", class: "block" %>
        <%= form.datetime_select :end_datetime, id: :task_end_datetime, class: "mt-1 block  border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div data-controller="file-drop"
        data-action="dragover->file-drop#dragover dragleave->file-drop#dragleave drop->file-drop#drop">
        <%= form.label :images, "画像", class: "block" %>
        <label for="task_images" class="mt-1 block border border-gray-300 rounded-md shadow-sm p-4 text-center cursor-pointer hover:bg-gray-50" >
            <span class="text-sm text-gray-500">ファイルを選択</span>
            <%= form.file_field :images, multiple: true, direct_upload: true ,accept:"image/*", class: "hidden",data:{file_drop_target:"input" ,action:"change->file-drop#previewFiles"} %>
            <div class="mt-2 text-sm text-gray-500">ドラッグ＆ドロップで画像を追加できます</div>
        </label>
            <div class="mt-4 flex flex-wrap gap-1" data-file-drop-target="preview">
                <% if @task.images.attached? %>
                    <% @task.images.each do |image| %>
                        <div class="inline-flex mx-1 mb-2 relative" data-image-id="<%= image.id %>" data-existing="true">
                            <%= image_tag image,width:100 ,class: "rounded" %>
                            <button type="button" class="absolute top-0 right-0 bg-red-500 text-white rounded-full w-6 h-6 text-xs flex items-center justify-center hover:bg-red-700" data-action="click->file-drop#removeExistingImage">
                            ×
                            </button>
                        </div>
                    <% end %>
                <% end %>
            </div>
            <%= form.hidden_field :images_to_delete, value: "", data: { file_drop_target: "deleteIds" } %>

    </div>


    <div class="actions flex justify-end">
        <%= form.submit "保存",class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-md" %>
        <%= link_to "キャンセル", @task, class: "text-gray-500 hover:text-gray-700 py-2 px-4 rounded-md" %>
    </div>
<%end%>
</div>