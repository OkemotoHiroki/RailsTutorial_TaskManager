<%= form_with(model: @task) do |form| %>
    <% if @task.errors.any? %>
        <div id="error_explanation">
        <h2><%= pluralize(@task.errors.count, "error") %> prohibited this task from being saved:</h2>
        <ul>
            <% @task.errors.full_messages.each do |message| %>
            <li><%= message %></li>
            <% end %>
        </ul>
        </div>
    <% end %>

    <div class="field">
        <%= form.label :name, "タイトル" %>
        <%= form.text_field :name, id: :task_name %>
    </div>

    <div class="field">
        <%= form.label :detail, "内容" %>
        <%= form.text_area :detail, id: :task_detail %>
    </div>

    <div class="field">
        <%= form.label :start_datetime, "開始日時" %>
        <%= form.datetime_select :start_datetime, id: :task_start_datetime %>
    </div>
    <div class="field">
        <%= form.label :end_datetime, "終了日時" %>
        <%= form.datetime_select :end_datetime, id: :task_end_datetime %>
    </div>
    <div class="actions">
        <%= form.submit %>
    </div>
<%end%>