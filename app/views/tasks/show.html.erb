<%= link_to "戻る", tasks_path, class: " text-blue-500 hover:text-blue-700" %>
<%= link_to "編集", edit_task_path(@task), class: "text-blue-500 hover:text-blue-700" %>
<%= link_to "削除", task_path(@task), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "text-red-500 hover:text-red-700" %>
<h1 class="text-3xl font-bold mb-4">
    <%= @task.name %>
</h1>
<p class="text-gray-600">
<%= @task.start_datetime.strftime("%Y-%m-%d %H:%M") %>　〜　<%= @task.end_datetime.strftime("%Y-%m-%d %H:%M") %>
</p>
<p class="mt-4">
    <%= @task.detail %>
</p>
<% if @task.images.attached? %>
  <div class="flex flex-wrap gap-4 mt-4">
    <% @task.images.each do |image| %>
      <%= image_tag image, style: "max-width: 100%;" ,class: "rounded" %>
    <% end %>
  </div>
<% end %>
