<%= link_to "戻る", tasks_path %>
<%= link_to "編集", edit_task_path(@task) %>
<%= link_to "削除", task_path(@task),data: {turbo_method: :delete, turbo_confirm: "本当に削除しますか？" } %>
<h1>
    <%= @task.name %>
</h1>
<p>
<%= @task.start_datetime.strftime("%Y-%m-%d %H:%M") %>　〜　<%= @task.end_datetime.strftime("%Y-%m-%d %H:%M") %>
</p>
<p>
    <%= @task.detail %>
</p>

