<%= form_with(model: @user) do |form| %>
    <% if @user.errors.any? %>
        <div id="">
        <h2><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h2>
        <ul>
            <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
            <% end %>
        </ul>
        </div>
    <% end %>
    <div class="flex flex-col mb-4">
         <%= form.label :name, "名前", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :name, id: :user_name, class: "shadow appearance-none border rounded py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" %>
    </div>
    
    <div class="flex flex-col mb-4">
        <%= form.label :email, "メールアドレス", class: "block text-sm font-medium text-gray-700" %>
        <%= form.email_field :email, id: :user_email, class: "shadow appearance-none border rounded py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" %>
    </div>
    
    <div class="flex flex-col mb-4">
        <%= form.label :password, "パスワード", class: "block text-sm font-medium text-gray-700" %>
        <%= form.password_field :password, id: :user_password, class: "shadow appearance-none border rounded py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" %>
    </div>
    <div class="flex flex-col mb-4">
        <%= form.label :password_confirmation, "パスワード確認", class: "block text-sm font-medium text-gray-700" %>
        <%= form.password_field :password_confirmation, id: :user_password_confirmation, class: "shadow appearance-none border rounded py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" %>
    </div>

    <div class="actions flex justify-end">
        <%= form.submit "登録", class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-md" %>
        <%= link_to "キャンセル", @user, class: "text-gray-500 hover:text-gray-700 py-2 px-4 rounded-md" %>
    </div>

<% end %>